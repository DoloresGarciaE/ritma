// Ritma — schema v1: el núcleo multi-tenant (Plan de proyecto §7) + las tablas de
// identidad de Better Auth (F0.4).
//
// Reparto de responsabilidades: Better Auth es dueño de User, Session, Account y
// Verification (identidad y sesión). La tenencia —qué organización, con qué rol— es
// nuestra: vive en Organization y Membership, y es la única fuente de verdad. Por eso
// no usamos su plugin de organizaciones.
//
// Los modelos del dominio (Student, ClassGroup, Charge, Payment…) llegan en sus bloques.
//
// Prisma 7: la URL de la base NO se declara acá. El CLI la toma de prisma.config.ts
// (DIRECT_URL) y la app la pasa por el driver adapter (DATABASE_URL, pooled).
//
// OJO al correr `npx @better-auth/cli generate`: reescribe este archivo y le agrega
// `@@map("user")` y compañía, que renombrarían las tablas a minúscula. Las sacamos: su
// adapter habla con los MODELOS de Prisma, no con los nombres de tabla, así que el @@map
// no le aporta nada y nos dejaría medio schema en PascalCase y medio en minúscula.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrgType {
  INDEPENDENT
  STUDIO
}

enum Role {
  OWNER
  ADMIN
  TEACHER
}

/// El tenant: unidad de aislamiento de datos (Plan §3).
model Organization {
  id               String   @id @default(cuid())
  name             String
  type             OrgType
  currency         String   @default("ARS")
  timezone         String   @default("America/Argentina/Buenos_Aires")
  /// Día del mes en que vencen las cuotas (RN2).
  dueDay           Int      @default(10)
  reminderTemplate String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships Membership[]
  disciplines Discipline[]
  students    Student[]
  groups      ClassGroup[]
  slots       ScheduleSlot[]
  sessions    ClassSession[]
}

/// Alumno del padrón (Plan §7, HU2.1–2.3).
///
/// Los alumnos NO son usuarios: no tienen login ni reciben invitaciones (Plan §3, §4).
/// Son datos de la organización, y punto.
model Student {
  id     String  @id @default(cuid())
  orgId  String
  name   String
  /// Guardado en E.164 ("+5491155554433") para que wa.me funcione (S5). Se normaliza en
  /// el servicio con libphonenumber-js, default AR. Opcional: el alta express pide lo
  /// mínimo, y hay alumnos sin teléfono.
  phone  String?
  email  String?
  note   String?
  /// RN9: la baja es LÓGICA. Nunca se borra un alumno: deja de aparecer en las listas
  /// activas pero su ficha y su historial de pagos quedan consultables.
  active Boolean @default(true)

  /// `name` normalizado para buscar: minúsculas y sin tildes ("Iñaki Pérez" → "inaki perez").
  /// Lo calcula el servicio en cada escritura (ver server/services/students.ts).
  ///
  /// Por qué una columna y no `unaccent` de Postgres: la extensión exigiría SQL crudo, que
  /// se saltea `withOrg` y está prohibido fuera de src/lib/ (F0.6). Así la búsqueda es una
  /// query normal de Prisma, indexada, testeable y sin extensiones.
  searchName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// El índice líder por orgId cumple la convención de §7 y sirve a la vez para la lista
  /// (filtrada por org + activos) y para la búsqueda por prefijo/substring.
  @@index([orgId, active])
  @@index([orgId, searchName])
}

/// Catálogo de disciplinas de la organización: árabe, folklore, canto… (Plan §3, §7).
model Discipline {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  groups ClassGroup[]

  // El unique ya indexa por orgId (es la columna líder), así que cumple la convención
  // de §7 sin pagar un segundo índice. Además evita disciplinas repetidas en una org.
  @@unique([orgId, name])
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
  DONE
}

/// Grupo (comisión): la unidad central de la agenda (Plan §3, HU3.1).
///
/// SIN `teacherId` (llega con TeacherProfile en S9) ni `spaceId` (Space, S8): en la
/// Fase 1 la org independiente tiene un solo profe implícito. Desvío del borrador de
/// §7 registrado ahí mismo; la migración que los agrega va en esos bloques.
model ClassGroup {
  id           String  @id @default(cuid())
  orgId        String
  disciplineId String
  name         String
  /// Tarifa de referencia (HU3.1): el precio sugerido al inscribir, no un contrato.
  /// Decimal(12,2) queda como precedente de precisión para Charge/Payment (S3/S4).
  defaultPrice Decimal @db.Decimal(12, 2)
  /// RN9: baja lógica. Un grupo inactivo desaparece de la agenda, no de la historia.
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Restrict: hoy no hay UI para borrar disciplinas; si llega, no puede dejar grupos
  // huérfanos en silencio.
  discipline Discipline   @relation(fields: [disciplineId], references: [id], onDelete: Restrict)

  slots    ScheduleSlot[]
  sessions ClassSession[]

  @@index([orgId, active])
}

/// Franja recurrente de un grupo: día de semana + hora + duración (Plan §3, RN10).
/// Recurrencia propia simple, sin RRULE (Plan §10). Un grupo puede tener varias.
model ScheduleSlot {
  id          String @id @default(cuid())
  orgId       String
  groupId     String
  /// 0–6 convención JS (0 = domingo), para calzar con `Date.getDay()` sin traducciones.
  /// La UI renderiza lunes-primero.
  weekday     Int
  /// Hora LOCAL de la org, "HH:mm" ("19:00"). Nunca un instante UTC (RN10).
  startTime   String
  durationMin Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  group ClassGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  sessions ClassSession[]

  @@index([orgId])
  @@index([groupId])
}

/// EXCEPCIÓN sobre una ocurrencia calculada (HU3.3, RN8).
///
/// Las ocurrencias NO se materializan: se calculan al vuelo desde las franjas para el
/// rango visible (server/services/schedule.ts). Una fila acá existe SOLO si esa
/// ocurrencia concreta se desvió: cancelada, reprogramada o anotada. Restablecer una
/// sesión = borrar la fila (volver a la verdad calculada).
///
/// La identidad de la ocurrencia es `(slotId, date)` con `date` = fecha CIVIL original
/// (@db.Date, sin hora — RN10). No alcanza `(groupId, date)`: un grupo puede tener dos
/// franjas el mismo día. Reprogramar NO cambia la identidad: la nueva posición vive en
/// `movedToDate`/`movedToStartTime` y el status queda SCHEDULED.
model ClassSession {
  id      String        @id @default(cuid())
  orgId   String
  groupId String
  slotId  String
  date    DateTime      @db.Date
  status  SessionStatus @default(SCHEDULED)
  note    String?

  movedToDate      DateTime? @db.Date
  movedToStartTime String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  group ClassGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slot  ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId, date])
  // Las dos queries de weekData: excepciones cuya fecha original cae en la semana, y
  // las reprogramadas HACIA la semana desde una fecha de afuera.
  @@index([orgId, date])
  @@index([orgId, movedToDate])
  @@index([groupId])
}

/// Persona con cuenta y login. Puede pertenecer a varias organizaciones.
/// Los alumnos NO son usuarios: son datos de la organización (Plan §3).
/// emailVerified e image los agrega Better Auth.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]
}

/// Vínculo usuario ↔ organización con un rol (Plan §4).
model Membership {
  userId    String
  orgId     String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // La PK compuesta ya indexa por userId; §7 pide índice por orgId en toda tabla.
  @@id([userId, orgId])
  @@index([orgId])
}

/// Better Auth. Los ids de sus tablas los genera la librería, por eso no llevan @default.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Better Auth: credenciales locales (providerId "credential") y cuentas OAuth.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Better Auth: tokens de verificación de email y de reseteo de contraseña.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
