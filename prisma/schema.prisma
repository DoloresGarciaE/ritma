// Ritma — schema v1: el núcleo multi-tenant (Plan de proyecto §7) + las tablas de
// identidad de Better Auth (F0.4).
//
// Reparto de responsabilidades: Better Auth es dueño de User, Session, Account y
// Verification (identidad y sesión). La tenencia —qué organización, con qué rol— es
// nuestra: vive en Organization y Membership, y es la única fuente de verdad. Por eso
// no usamos su plugin de organizaciones.
//
// Los modelos del dominio (Student, ClassGroup, Charge, Payment…) llegan en sus bloques.
//
// Prisma 7: la URL de la base NO se declara acá. El CLI la toma de prisma.config.ts
// (DIRECT_URL) y la app la pasa por el driver adapter (DATABASE_URL, pooled).
//
// OJO al correr `npx @better-auth/cli generate`: reescribe este archivo y le agrega
// `@@map("user")` y compañía, que renombrarían las tablas a minúscula. Las sacamos: su
// adapter habla con los MODELOS de Prisma, no con los nombres de tabla, así que el @@map
// no le aporta nada y nos dejaría medio schema en PascalCase y medio en minúscula.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrgType {
  INDEPENDENT
  STUDIO
}

enum Role {
  OWNER
  ADMIN
  TEACHER
}

/// Qué clase de profe es dentro de la org (Plan §7): el owner que además dicta
/// (OWNER_TEACHER), staff con acuerdo de porcentaje (STAFF, acuerdos en S9) o un
/// externo que alquila salón (EXTERNAL, S10 — puede no tener cuenta).
enum TeacherKind {
  OWNER_TEACHER
  STAFF
  EXTERNAL
}

/// Tipo de acuerdo económico (Plan §7): porcentaje para STAFF (S9), alquiler para
/// EXTERNAL (S10, RN7).
enum AgreementType {
  REVENUE_SHARE
  RENTAL
}

/// Cómo se calcula el alquiler de un externo (RN7, S10).
enum RentalPeriod {
  MONTHLY
  PER_SESSION
  PER_HOUR
}

/// Acuerdo económico de un perfil docente (HU6.1, RN6/RN7). CAMBIAR las condiciones
/// CREA un registro nuevo con su `validFrom`: el historial queda intacto. Un pago de
/// alumno liquida con el acuerdo vigente a su `paidAt` (RN6-bis, S9); un cargo de
/// alquiler usa el acuerdo vigente al ÚLTIMO día de su período (decisión S10 — un solo
/// acuerdo por cargo, sin tramos).
model Agreement {
  id       String        @id @default(cuid())
  orgId    String
  teacherId String
  type     AgreementType
  /// Porcentaje de retención del ESTUDIO (30 = 30%). Decimal: la plata no toca floats.
  studioPercent Decimal? @db.Decimal(5, 2)
  /// RENTAL (S10): la tarifa — por mes, por sesión o por hora según `rentalPeriod`.
  rentalAmount Decimal? @db.Decimal(12, 2)
  rentalPeriod RentalPeriod?
  /// Fecha civil desde la que rige (@db.Date, RN10).
  validFrom DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  /// Dos acuerdos del mismo profe desde el mismo día serían ambiguos.
  @@unique([teacherId, validFrom])
  @@index([orgId, teacherId, validFrom])
}

/// Cargo de alquiler de un profe EXTERNAL (HU6.3, RN7): generado por el cron del día 1
/// — MONTHLY para el período que arranca; PER_SESSION/PER_HOUR para el que acaba de
/// cerrar, contando las ocurrencias NO canceladas (RN8) por su fecha MOSTRADA (una
/// movida cobra donde se dictó — decisión S10). Sin imputaciones ni parciales: se marca
/// pagado completo con fecha y método (decisión S10, HU6.3). `sessionsCount`/
/// `minutesTotal`/`unspacedSessions` congelan los HECHOS del cálculo al generar (el
/// monto es editable en PENDING, mismo espíritu que RN2 — los hechos no).
model RentalCharge {
  id        String @id @default(cuid())
  orgId     String
  teacherId String
  /// "YYYY-MM", el período que cobra (RN10, zona de la org).
  period    String
  amount    Decimal @db.Decimal(12, 2)
  currency  String
  /// Día `dueDay` de la org en el MES DE GENERACIÓN (@db.Date): un cargo no vence
  /// antes de existir. `markOverdue` lo incluye (RN3).
  dueDate DateTime     @db.Date
  status  ChargeStatus @default(PENDING)
  /// El pago (HU6.3): fecha civil y método, sin más maquinaria.
  paidAt DateTime?  @db.Date
  method PayMethod?
  /// Los hechos del cálculo (0 en MONTHLY): sesiones contadas, minutos sumados
  /// (PER_HOUR) y cuántas fueron de grupos SIN salón (se cuentan igual y se señalan).
  sessionsCount    Int @default(0)
  minutesTotal     Int @default(0)
  unspacedSessions Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  /// Un cargo por externo y período: la garantía dura de idempotencia del cron.
  @@unique([teacherId, period])
  @@index([orgId, period])
  @@index([orgId, status])
}

enum SettlementStatus {
  /// Declarado por §7; en el MVP el borrador NO persiste (se calcula al abrir): las
  /// filas nacen CLOSED. El valor existe para que el ciclo del plan quede representable.
  OPEN
  CLOSED
  PAID
}

/// Liquidación mensual de un profe STAFF (HU6.2/HU6.4, RN6): los números CONGELADOS al
/// cerrar. `netToTeacher` puede ser negativo (el profe cobró en mano más de lo que le
/// corresponde) y se muestra con signo explícito (Componentes §4.2). Cerrar vincula
/// `settlementId` en cada pago incluido: esos pagos quedan inmutables (RN12 se completa
/// acá). Reabrir no existe en el MVP.
model Settlement {
  id       String @id @default(cuid())
  orgId    String
  teacherId String
  /// "YYYY-MM", calculado en la zona de la org (RN10).
  period   String
  gross              Decimal @db.Decimal(12, 2)
  studioShare        Decimal @db.Decimal(12, 2)
  collectedByTeacher Decimal @db.Decimal(12, 2)
  netToTeacher       Decimal @db.Decimal(12, 2)
  status   SettlementStatus
  /// Instantes de los dos eventos del ciclo; la UI los muestra como fecha civil (RN10).
  closedAt DateTime
  paidAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  payments Payment[]

  /// Un cierre por profe y período: la garantía dura contra el doble cierre.
  @@unique([teacherId, period])
  @@index([orgId, period])
}

/// El tenant: unidad de aislamiento de datos (Plan §3).
model Organization {
  id               String   @id @default(cuid())
  name             String
  type             OrgType
  currency         String   @default("ARS")
  timezone         String   @default("America/Argentina/Buenos_Aires")
  /// Día del mes en que vencen las cuotas (RN2).
  dueDay           Int      @default(10)
  reminderTemplate String?
  /// Alias o CBU de cobro: la variable {alias} de la plantilla de recordatorio (HU5.2).
  /// Opcional: sin alias, la plantilla igual renderiza (la variable queda vacía).
  paymentAlias     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships Membership[]
  disciplines Discipline[]
  students    Student[]
  groups      ClassGroup[]
  slots       ScheduleSlot[]
  sessions    ClassSession[]
  enrollments Enrollment[]
  charges     Charge[]
  payments    Payment[]
  allocations PaymentAllocation[]
  reminders   ReminderLog[]
  teachers    TeacherProfile[]
  invitations Invitation[]
  spaces      Space[]
  agreements  Agreement[]
  settlements Settlement[]
  rentals     RentalCharge[]
}

/// Salón del estudio (Plan §3/§7, HU3.1/HU3.4 — S8). Solo una org STUDIO lo usa; en
/// una INDEPENDENT no existe ni un pixel de espacios.
///
/// RN9: la baja es LÓGICA (`active = false`) y, decisión S8, desasigna sus grupos en la
/// misma transacción (quedan "sin salón"): un salón que el estudio dejó de usar no puede
/// seguir ocupando el calendario. Reactivarlo no re-asigna nada — la confirmación lo
/// avisa. Los alquileres (precios, bookings, RentalCharge) llegan en S10.
model Space {
  id     String  @id @default(cuid())
  orgId  String
  name   String
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  groups ClassGroup[]

  // El unique ya indexa por orgId (columna líder): cumple la convención de §7 y evita
  // dos "Salón A" en la misma org (patrón Discipline).
  @@unique([orgId, name])
}

/// Perfil docente de la organización (Plan §7; adelantado de S9 en S7 — ADR-004).
///
/// Es la IDENTIDAD DOCENTE dentro de la org, separada de la cuenta de usuario:
/// `membershipUserId` la vincula a una Membership viva, y REVOCAR ACCESO (HU1.3) es
/// borrar la Membership y poner esto en null — el perfil, sus grupos y todo su
/// historial quedan intactos, re-vinculables si la persona vuelve. `null` también
/// cubre al EXTERNAL sin cuenta (S10).
model TeacherProfile {
  id               String      @id @default(cuid())
  orgId            String
  membershipUserId String?
  displayName      String
  kind             TeacherKind

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [membershipUserId], references: [id], onDelete: SetNull)

  groups           ClassGroup[]
  agreements       Agreement[]
  settlements      Settlement[]
  rentalCharges    RentalCharge[]
  receivedPayments Payment[]

  /// Un usuario tiene a lo sumo UN perfil por org; varios `null` conviven (perfiles
  /// desvinculados conservando historial).
  @@unique([orgId, membershipUserId])
  @@index([orgId])
}

/// Invitación al EQUIPO (ADMIN/TEACHER) por link de un solo uso (HU1.3). Los alumnos
/// NO son usuarios y jamás se invitan (Plan §3–§4).
///
/// El token es opaco (24 bytes aleatorios, el patrón del comprobante S5): la
/// autorización ES el token. REVOCAR = borrar la fila — no hay estado "revocada": un
/// token que no está en la base no autoriza nada, igual que rotar un comprobante.
/// REGENERAR = rotar el token y correr el vencimiento. La aceptada queda con `usedAt`
/// (un solo uso). `email` es solo el canal de envío, no restringe quién acepta: el
/// link es la llave, con o sin email.
model Invitation {
  id    String  @id @default(cuid())
  orgId String
  email String?
  /// Solo ADMIN o TEACHER (lo valida el servicio): OWNER no se invita, nace con la org.
  role      Role
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// Alumno del padrón (Plan §7, HU2.1–2.3).
///
/// Los alumnos NO son usuarios: no tienen login ni reciben invitaciones (Plan §3, §4).
/// Son datos de la organización, y punto.
model Student {
  id     String  @id @default(cuid())
  orgId  String
  name   String
  /// Guardado en E.164 ("+5491155554433") para que wa.me funcione (S5). Se normaliza en
  /// el servicio con libphonenumber-js, default AR. Opcional: el alta express pide lo
  /// mínimo, y hay alumnos sin teléfono.
  phone  String?
  email  String?
  note   String?
  /// RN9: la baja es LÓGICA. Nunca se borra un alumno: deja de aparecer en las listas
  /// activas pero su ficha y su historial de pagos quedan consultables.
  active Boolean @default(true)

  /// `name` normalizado para buscar: minúsculas y sin tildes ("Iñaki Pérez" → "inaki perez").
  /// Lo calcula el servicio en cada escritura (ver server/services/students.ts).
  ///
  /// Por qué una columna y no `unaccent` de Postgres: la extensión exigiría SQL crudo, que
  /// se saltea `withOrg` y está prohibido fuera de src/lib/ (F0.6). Así la búsqueda es una
  /// query normal de Prisma, indexada, testeable y sin extensiones.
  searchName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  enrollments Enrollment[]
  payments    Payment[]
  reminders   ReminderLog[]

  /// El índice líder por orgId cumple la convención de §7 y sirve a la vez para la lista
  /// (filtrada por org + activos) y para la búsqueda por prefijo/substring.
  @@index([orgId, active])
  @@index([orgId, searchName])
}

/// Catálogo de disciplinas de la organización: árabe, folklore, canto… (Plan §3, §7).
model Discipline {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  groups ClassGroup[]

  // El unique ya indexa por orgId (es la columna líder), así que cumple la convención
  // de §7 sin pagar un segundo índice. Además evita disciplinas repetidas en una org.
  @@unique([orgId, name])
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
  DONE
}

/// Grupo (comisión): la unidad central de la agenda (Plan §3, HU3.1).
///
/// `teacherId` llegó en S7 (adelantado de S9 — ADR-004); `spaceId` en S8. Null en
/// `teacherId` = "sin profe asignado": lo ven solo owner/admin — el scope de un
/// TEACHER es estrictamente `teacherId = su perfil`. En una org INDEPENDENT se
/// auto-asigna al perfil del owner (el único profe implícito de la Fase 1).
/// `spaceId` es SIEMPRE opcional (decisión S8): un grupo sin salón es ciudadano
/// pleno — aparece en el calendario en la columna "Sin salón".
model ClassGroup {
  id           String  @id @default(cuid())
  orgId        String
  disciplineId String
  teacherId    String?
  spaceId      String?
  name         String
  /// Tarifa de referencia (HU3.1): el precio sugerido al inscribir, no un contrato.
  /// Decimal(12,2) queda como precedente de precisión para Charge/Payment (S3/S4).
  defaultPrice Decimal @db.Decimal(12, 2)
  /// RN9: baja lógica. Un grupo inactivo desaparece de la agenda, no de la historia.
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Restrict: hoy no hay UI para borrar disciplinas; si llega, no puede dejar grupos
  // huérfanos en silencio.
  discipline Discipline   @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  // Restrict por la misma razón: los perfiles no se borran (revocar es desvincular),
  // y si algún día se borrara uno, no puede desasignar grupos en silencio.
  teacher    TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  // Restrict ídem: los salones no se borran (la baja es lógica y desasigna explícito).
  space      Space?          @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  slots       ScheduleSlot[]
  sessions    ClassSession[]
  enrollments Enrollment[]

  @@index([orgId, active])
  // El scope de teacher (S7): "sus grupos" es una query por org + perfil.
  @@index([orgId, teacherId])
}

/// Franja recurrente de un grupo: día de semana + hora + duración (Plan §3, RN10).
/// Recurrencia propia simple, sin RRULE (Plan §10). Un grupo puede tener varias.
model ScheduleSlot {
  id          String @id @default(cuid())
  orgId       String
  groupId     String
  /// 0–6 convención JS (0 = domingo), para calzar con `Date.getDay()` sin traducciones.
  /// La UI renderiza lunes-primero.
  weekday     Int
  /// Hora LOCAL de la org, "HH:mm" ("19:00"). Nunca un instante UTC (RN10).
  startTime   String
  durationMin Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  group ClassGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  sessions ClassSession[]

  @@index([orgId])
  @@index([groupId])
}

/// EXCEPCIÓN sobre una ocurrencia calculada (HU3.3, RN8).
///
/// Las ocurrencias NO se materializan: se calculan al vuelo desde las franjas para el
/// rango visible (server/services/schedule.ts). Una fila acá existe SOLO si esa
/// ocurrencia concreta se desvió: cancelada, reprogramada o anotada. Restablecer una
/// sesión = borrar la fila (volver a la verdad calculada).
///
/// La identidad de la ocurrencia es `(slotId, date)` con `date` = fecha CIVIL original
/// (@db.Date, sin hora — RN10). No alcanza `(groupId, date)`: un grupo puede tener dos
/// franjas el mismo día. Reprogramar NO cambia la identidad: la nueva posición vive en
/// `movedToDate`/`movedToStartTime` y el status queda SCHEDULED.
model ClassSession {
  id      String        @id @default(cuid())
  orgId   String
  groupId String
  slotId  String
  date    DateTime      @db.Date
  status  SessionStatus @default(SCHEDULED)
  note    String?

  movedToDate      DateTime? @db.Date
  movedToStartTime String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  group ClassGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slot  ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId, date])
  // Las dos queries de weekData: excepciones cuya fecha original cae en la semana, y
  // las reprogramadas HACIA la semana desde una fecha de afuera.
  @@index([orgId, date])
  @@index([orgId, movedToDate])
  @@index([groupId])
}

/// Planes de inscripción (Plan §7). PACK (N clases) queda fuera del MVP —depende de tomar
/// asistencia (Plan §5)— y el valor del enum se agrega recién cuando exista la lógica:
/// un valor sin código detrás sería un estado imposible de manejar.
enum PlanType {
  MONTHLY
  DROP_IN
}

enum ChargeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

/// Inscripción de un alumno a un grupo, con plan y precio pactado (HU4.1).
///
/// RN9: la baja de una inscripción es ponerle `endDate`, nunca borrarla — desde el período
/// siguiente no se generan cuotas, y las ya generadas persisten. Un alumno puede tener
/// varias inscripciones históricas al mismo grupo (se fue y volvió); el servicio impide
/// dos ABIERTAS (sin endDate) a la vez.
model Enrollment {
  id        String   @id @default(cuid())
  orgId     String
  studentId String
  groupId   String
  plan      PlanType
  /// Precio PACTADO de esta inscripción: hereda `defaultPrice` del grupo como sugerencia,
  /// pero es editable por alumno (HU4.1). RN1 genera cada cuota con ESTE monto.
  price     Decimal  @db.Decimal(12, 2)
  /// Fecha civil de alta (@db.Date, RN10): define desde qué período se generan cuotas.
  startDate DateTime @db.Date
  /// RN9: fecha civil de baja. El período que la contiene todavía genera su cuota.
  endDate   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   ClassGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  charges Charge[]

  // La ficha del alumno y los inscriptos del grupo, siempre filtrados por org (withOrg).
  @@index([orgId, studentId])
  @@index([orgId, groupId])
  @@index([studentId])
  @@index([groupId])
}

/// Cuota generada (RN1–RN3).
///
/// El unique `(enrollmentId, period)` es la GARANTÍA DURA de idempotencia del cron
/// (decisión S3): `generateCharges` upsertea sobre él con `update: {}`, así que correrlo
/// N veces deja exactamente las mismas filas — y no pisa una cuota editada a mano (RN2).
model Charge {
  id           String       @id @default(cuid())
  orgId        String
  enrollmentId String
  /// Período "YYYY-MM", calculado en la zona horaria de la org (RN10).
  period       String
  amount       Decimal      @db.Decimal(12, 2)
  /// RN10: cada monto guarda su moneda (copiada de la org al generar), para no bloquear
  /// multi-moneda futura. La org sigue siendo mono-moneda en el MVP.
  currency     String
  /// Fecha civil de vencimiento (@db.Date): día `dueDay` de la org en ese período,
  /// clampeado al último día del mes (dueDay 31 en abril → 30).
  dueDate      DateTime     @db.Date
  status       ChargeStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  enrollment Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  allocations PaymentAllocation[]
  reminders   ReminderLog[]

  @@unique([enrollmentId, period])
  // Deudores por período (query por org) y el cron diario de vencidas (cross-org, por
  // estado + vencimiento).
  @@index([orgId, period])
  @@index([status, dueDate])
}

enum PayMethod {
  CASH
  TRANSFER
  OTHER
}

/// RN5: quién recibió la plata. No cambia el estado de cuenta del alumno; sí el
/// resultado de la liquidación (S9). En una org independiente queda el default STUDIO
/// y la UI ni lo muestra.
enum ReceivedBy {
  STUDIO
  TEACHER
}

/// Pago registrado (HU4.3, RN4–RN5).
///
/// Sus imputaciones viven en `PaymentAllocation`; el SALDO A FAVOR del alumno no es una
/// columna: es `sum(pagos) − sum(imputaciones)` — un derivado, imposible de desincronizar.
/// Un pago sin liquidación (todas, en Fase 1) puede ELIMINARSE con confirmación
/// (propuesta RN12): la transacción revierte imputaciones y recalcula estados. La
/// inmutabilidad llega con el cierre de liquidaciones (RN6, S9).
model Payment {
  id        String     @id @default(cuid())
  orgId     String
  studentId String
  amount    Decimal    @db.Decimal(12, 2)
  /// RN10: cada monto lleva su moneda, copiada de la org al registrar (patrón Charge, S3).
  currency  String
  method    PayMethod
  /// RN5. `receivedById` dice QUÉ profe (S9): imprescindible para el C de RN6. Null en
  /// un pago TEACHER = "en mano sin atribuir" — se CANTA en Liquidaciones, no se asume
  /// (decisión S9). Un teacher que registra su cobro se auto-atribuye.
  receivedBy   ReceivedBy @default(STUDIO)
  receivedById String?
  /// La liquidación que lo CONGELÓ (S9, RN6/RN12): con esto puesto, el pago es
  /// inmutable — no se elimina ni se reimputa (el crédito del cron lo saltea).
  settlementId String?
  /// Fecha civil del pago (@db.Date, RN10), default hoy en la UI. El orden fino de
  /// imputación lo desempata `createdAt`.
  paidAt    DateTime   @db.Date
  /// Key del comprobante en R2 (`{orgId}/payments/{paymentId}`), NUNCA una URL: las URLs
  /// se firman cortas al momento de ver, previa verificación de permisos.
  attachmentKey String?
  /// Token opaco criptográficamente aleatorio del comprobante público (S5). Se genera
  /// SIEMPRE al crear el pago; la página que lo consume llega en S5.
  receiptToken  String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Restrict en ambos (S9): ni perfiles ni liquidaciones se borran, y si algún día se
  // borrara uno, no puede desatribuir/descongelar pagos en silencio.
  receivedByTeacher TeacherProfile? @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  settlement        Settlement?     @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  allocations PaymentAllocation[]

  // La ficha del alumno y (S6) los totales del mes.
  @@index([orgId, studentId])
  @@index([orgId, paidAt])
  @@index([studentId])
  // S9: el drill-down de una liquidación cerrada lee por su membresía congelada.
  @@index([settlementId])
  @@index([receivedById])
}

/// Imputación de un pago a una cuota (RN4): cuánta plata de ESTE pago cubre ESA cuota.
///
/// La PK compuesta impide dos imputaciones del mismo pago a la misma cuota. Invariantes
/// (validadas en el servicio, dentro de la transacción): la suma de imputaciones de un
/// pago nunca supera su monto; una imputación nunca supera el remanente de su cuota.
model PaymentAllocation {
  orgId     String
  paymentId String
  chargeId  String
  amount    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge  Charge       @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@id([paymentId, chargeId])
  @@index([orgId])
  @@index([chargeId])
}

/// El canal por el que salió un recordatorio. WHATSAPP_LINK es el deep link wa.me del
/// MVP (el envío real lo hace el profe en su WhatsApp); la Cloud API llega en fase 3
/// y sería otro valor. En el §7 del plan el enum se llama `Channel`; acá lleva el
/// prefijo para no chocar con futuros canales de otras cosas — ver nota S5.
enum ReminderChannel {
  WHATSAPP_LINK
  EMAIL
}

/// Registro de recordatorios enviados (HU5.2–5.3): fecha y canal, nada más — no hay
/// estados de "entregado" o "leído" que el MVP no pueda conocer.
///
/// WHATSAPP_LINK es MEJOR ESFUERZO por diseño: se loguea al disparar el link wa.me,
/// antes de que el profe toque "enviar" en WhatsApp (F2 paso 3 — la app no puede saber
/// más). EMAIL en cambio se loguea recién cuando Resend aceptó el envío.
model ReminderLog {
  id        String          @id @default(cuid())
  orgId     String
  studentId String
  /// Opcional (§7): el recordatorio del MVP es por la deuda del período, no por una
  /// cuota puntual — queda null. El campo existe para recordatorios por cuota futuros.
  chargeId  String?
  channel   ReminderChannel
  /// Instante real del disparo (no fecha civil): es un evento, no un dato de negocio
  /// con día "de la org". La ficha lo muestra como fecha civil en la zona de la org.
  sentAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// SetNull y no Cascade: si alguna vez se borrara la cuota, el historial de que el
  /// recordatorio SALIÓ tiene que sobrevivir (las cuotas de negocio igual no se borran).
  charge  Charge?      @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  // El historial de la ficha (por alumno, más nuevo primero) y la convención de §7.
  @@index([orgId, studentId, sentAt])
  @@index([studentId])
  @@index([chargeId])
}

/// Persona con cuenta y login. Puede pertenecer a varias organizaciones.
/// Los alumnos NO son usuarios: son datos de la organización (Plan §3).
/// emailVerified e image los agrega Better Auth.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]
  /// Perfiles docentes vinculados (S7). La FK vive en TeacherProfile: SetNull ahí
  /// para que borrar un User jamás borre la historia docente de una org.
  teacherProfiles TeacherProfile[]
}

/// Vínculo usuario ↔ organización con un rol (Plan §4).
model Membership {
  userId    String
  orgId     String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // La PK compuesta ya indexa por userId; §7 pide índice por orgId en toda tabla.
  @@id([userId, orgId])
  @@index([orgId])
}

/// Better Auth. Los ids de sus tablas los genera la librería, por eso no llevan @default.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Better Auth: credenciales locales (providerId "credential") y cuentas OAuth.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Better Auth: tokens de verificación de email y de reseteo de contraseña.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
